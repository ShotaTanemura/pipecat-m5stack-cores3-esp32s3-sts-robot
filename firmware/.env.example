# firmware - Environment Variables
#
# Copy this file to .env and fill in your values. These are consumed by CMake at
# *configure* time and baked into the built binary -- see firmware/README.md for how
# to load them and why `idf.py fullclean` is needed after changing them.
#
# Values may be written quoted (WIFI_SSID="my-ssid") or bare (WIFI_SSID=my-ssid).

# WiFi network the device joins on boot.
WIFI_SSID=
WIFI_PASSWORD=

# The agent server's SmallWebRTC signaling endpoint, reachable on the same LAN as the
# device (not localhost). Matches `uv run bot.py -t webrtc --esp32 --host <LAN IP>`
# in agent/README.md, which serves this on port 7860 by default. The build rejects a
# URL without an explicit port -- a portless URL dials port 80, where nothing listens.
# Example: http://192.168.1.10:7860/api/offer
PIPECAT_SMALLWEBRTC_URL=

# Optional: set to 1 to log every WebRTC datachannel (RTVI) message.
# LOG_DATACHANNEL_MESSAGES=1
